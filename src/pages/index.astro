---
import KnowledgeLayout from '../layouts/KnowledgeLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const paths = [
  { number: '01', title: 'Gitのしくみを知る', copy: '変更を記録するとはどういうこと？GitとGitHubの違いから始めます。', href: `${base}git-basics/`, tag: 'まずはここから', icon: '🌱' },
  { number: '02', title: 'ひとりで使ってみる', copy: 'プロジェクトを開き、変更を記録してGitHubへ共有するまでを体験。', href: `${base}app-guide/`, tag: 'アプリ操作', icon: '🧭' },
  { number: '03', title: 'チームで開発する', copy: 'タスクからブランチ、レビュー、取り込みまでの流れを学びます。', href: `${base}teamwork/`, tag: '実践ガイド', icon: '🤝' },
  { number: '04', title: '用語や困りごとを調べる', copy: 'やさしい言葉の用語集と、よくあるトラブルの対処方法。', href: `${base}reference/`, tag: '辞書・FAQ', icon: '🔎' },
  { number: '05', title: '3分で操作を練習する', copy: '変更・記録・共有を、ミニ体験コーナーで試してみよう。', href: `${base}practice/`, tag: 'さわって学ぶ', icon: '🧪' },
];
---
<KnowledgeLayout title="やさしいGit｜GitとGitHubを初心者向けに学ぶ" description="GitとGitHubの基本、チーム開発の流れ、やさしいGitアプリの使い方を、図と具体例で学べる無料ガイド。">
  <section class="home-hero">
    <div class="home-hero-copy">
      <p class="hero-kicker"><span></span> はじめてのGit・GitHubガイド</p>
      <h1>つくる楽しさを、<br /><em>記録して育てよう。</em></h1>
      <p class="home-lead">Gitって何？ 変更をどうやって仲間に届けるの？<br />初めてでも大丈夫。基本からチーム開発まで、一歩ずつ学べます。</p>
      <div class="home-actions">
        <a class="home-button primary" href={`${base}git-basics/`}>Gitの基本から読む <span aria-hidden="true">→</span></a>
        <a class="home-button quiet" href={`${base}app-guide/`}>アプリの使い方を見る</a>
      </div>
      <p class="hero-footnote">専門用語には、やさしい説明を添えています。</p>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="visual-orbit orbit-one"></div><div class="visual-orbit orbit-two"></div>
      <div class="visual-leaf leaf-one">✦</div><div class="visual-leaf leaf-two">✿</div>
      <div class="visual-center"><span>🌿</span><strong>小さく作って<br />一緒に育てる</strong></div>
      <div class="visual-node node-top"><b>01</b><span>変更する</span></div>
      <div class="visual-node node-right"><b>02</b><span>記録する</span></div>
      <div class="visual-node node-bottom"><b>03</b><span>共有する</span></div>
      <div class="visual-node node-left"><b>04</b><span>相談する</span></div>
    </div>
  </section>

  <section class="welcome-strip" aria-label="学び方">
    <span class="welcome-icon">☕</span>
    <p><strong>わからない言葉があっても大丈夫。</strong> まずは気になるところから。手を動かしながら、少しずつ覚えていきましょう。</p>
    <a href={`${base}reference/`}>用語を調べる ↗</a>
  </section>

  <section class="home-section learning-section">
    <div class="section-heading"><div><p class="eyebrow">YOUR LEARNING PATH</p><h2>目的に合わせて、読み進めよう。</h2></div><p>順番に読むのも、知りたい項目から探すのも自由です。</p></div>
    <div class="path-grid">
      {paths.map((path) => <a class="path-card" href={path.href}>
        <div class="path-card-top"><span class="path-icon" aria-hidden="true">{path.icon}</span><span class="path-tag">{path.tag}</span></div>
        <p class="path-number">LEARNING PATH {path.number}</p><h3>{path.title}</h3><p class="path-copy">{path.copy}</p>
        <span class="path-arrow" aria-hidden="true">↗</span>
      </a>)}
    </div>
  </section>

  <section class="home-section flow-section">
    <div class="section-heading"><div><p class="eyebrow">GIT IN ONE MINUTE</p><h2>Gitの基本は、この流れ。</h2></div><a class="text-link" href={`${base}git-basics/#basic-flow`}>流れをくわしく読む ↗</a></div>
    <div class="home-flow">
      <div><span>✏️</span><strong>変更</strong><small>ファイルを編集</small></div><i>→</i>
      <div><span>📸</span><strong>記録</strong><small>変更を保存</small></div><i>→</i>
      <div><span>☁️</span><strong>共有</strong><small>GitHubへ送る</small></div><i>→</i>
      <div><span>💬</span><strong>相談</strong><small>仲間と確認</small></div>
    </div>
    <p class="flow-caption">Gitは「変更を記録する仕組み」、GitHubは「記録を共有して一緒に作る場所」です。</p>
  </section>

  <section class="app-promo">
    <div class="promo-mark">🌱</div><div><p class="eyebrow">A FRIENDLY DESKTOP APP</p><h2>操作も、やさしい日本語で。</h2><p>「やさしいGit」は、GitHubの共有やブランチの管理を画面から進められるデスクトップアプリです。Windows・macOS・Linuxに対応しています。</p></div>
    <div class="promo-actions"><a class="home-button primary" href="https://github.com/rumo-dev/yasashii-git/releases/latest">無料でダウンロード ↗</a><a class="text-link" href={`${base}app-guide/`}>使い方を読む</a></div>
  </section>
</KnowledgeLayout>

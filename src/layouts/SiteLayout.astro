---
import '../styles/site.css';
const title = 'やさしいGit チュートリアル';
const description = 'やさしいGitの使い方、GitHubでのチーム開発、開発者向けの手順を初心者向けに解説します。';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8f3" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  </head>
  <body>
    <a class="skip-link" href="#top">本文へ移動</a>
    <slot />
    <script src="../scripts/site.js"></script>
  </body>
</html>
